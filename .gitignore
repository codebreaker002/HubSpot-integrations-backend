# Unified .gitignore combining Python & Node project needs

# macOS
.DS_Store

# Python bytecode / optimized files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging (keep if you don't publish packages)
build/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
MANIFEST

# Virtual environments / environments
.env
.env*/
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Dependency/lock files (uncomment to track if desired)
# Pipfile.lock
# poetry.lock
# uv.lock
# pdm.lock
.pdm-python
.pdm-build/
.pixi
__pypackages__/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
coverage/

# Type checking caches
.mypy_cache/
.pyre/
.pytype/
cython_debug/
.ruff_cache/

# Logs
*.log

# Databases
*.sqlite3
*.db
db.sqlite3
db.sqlite3-journal

# Framework specifics
local_settings.py
instance/
.webassets-cache
.scrapy
docs/_build/
.pybuilder/
target/
.ipynb_checkpoints
profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid
*.sage.py

# IDE/editor
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.abstra/
.cursorignore
.cursorindexingignore

# Node / frontend
frontend/node_modules/
frontend/.env
frontend/.next/
frontend/dist/
frontend/build/

# Package managers (decide if you want to commit lockfiles; remove lines to track them)
pnpm-lock.yaml
yarn.lock
package-lock.json

# Ignore credentials & secrets
backend/.env
backend/*.secret.json

# Redis dump
dump.rdb

# Generated / backup
*.bak

# Marimo (if used)
marimo/_static/
marimo/_lsp/
__marimo__/

# PyPI config
.pypirc

